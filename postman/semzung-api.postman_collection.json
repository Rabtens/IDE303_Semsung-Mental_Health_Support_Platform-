{
  "info": {
    "name": "Semzung API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "pm.test('service is healthy', () => pm.expect(pm.response.json().status).to.eql('ok'));"] }
      }]
    },
    {
      "name": "Reject invalid mood",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"mood_score\":9,\"session_id\":\"postman-ci\"}" },
        "url": "{{baseUrl}}/api/mood"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('status is 400', () => pm.response.to.have.status(400));"] }
      }]
    }
  ]
}
