.header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  border-bottom: 1px solid var(--border);
  padding: 16px 40px;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.nav-container {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text-light);
  text-decoration: none;
  font-family: 'Lora', serif;
  cursor: pointer;
  transition: transform 0.3s;
}

.logo:hover {
  transform: scale(1.05);
}

.logo-icon {
  width: 120px;
  height: 60px;
  background: transparent;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-light);
  font-size: 1.2rem;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: left center;
}

.nav {
  display: flex;
  align-items: center;
  gap: 40px;
}

.nav a {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 500;
  transition: color 0.3s;
  cursor: pointer;
}

.nav a:hover {
  color: var(--accent);
}

.nav-link {
  background: transparent;
  color: var(--text-muted);
  border: none;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  font-family: 'DM Sans', sans-serif;
  padding: 0;
  transition: color 0.3s;
}

.nav-link:hover {
  color: var(--accent);
}

.nav-mood-btn {
  background: transparent;
  color: var(--text-muted);
  border: none;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  font-family: 'DM Sans', sans-serif;
  padding: 0;
  transition: color 0.3s;
}

.nav-mood-btn:hover {
  color: var(--accent);
}

.header-user-section {
  display: flex;
  align-items: center;
  gap: 20px;
}

.header-user-info {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  transition: all 0.3s;
}

.header-user-info:hover {
  opacity: 0.8;
}

.header-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--accent);
  transition: all 0.3s;
}

.header-avatar:hover {
  transform: scale(1.1);
  box-shadow: 0 0 12px rgba(0, 212, 170, 0.4);
}

.user-email {
  color: var(--text-light);
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: color 0.3s;
}

.user-email:hover {
  color: var(--accent);
}

.access-mode {
  color: var(--accent);
  font-size: 0.85rem;
  padding: 6px 12px;
  background: rgba(0, 212, 170, 0.1);
  border: 1px solid var(--accent);
  border-radius: 12px;
  font-weight: 500;
}

.signout-btn {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border);
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  font-family: 'DM Sans', sans-serif;
  transition: all 0.3s;
}

.signout-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.cta-btn-primary {
  background: var(--accent);
  color: var(--secondary);
  border: none;
  padding: 10px 24px;
  border-radius: 6px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  font-family: 'DM Sans', sans-serif;
  transition: all 0.3s;
}

.cta-btn-primary:hover {
  background: var(--accent-light);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(0, 212, 170, 0.3);
}

/* Responsive Design */
@media (max-width: 768px) {
  .header {
    padding: 12px 20px;
  }

  .nav-container {
    flex-wrap: wrap;
  }

  .logo-icon {
    width: 100px;
    height: 50px;
  }

  .nav {
    gap: 20px;
    order: 3;
    width: 100%;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .header-user-section {
    gap: 10px;
  }

  .user-email {
    display: none;
  }
}

@media (max-width: 480px) {
  .header {
    padding: 10px 15px;
  }

  .logo-icon {
    width: 80px;
    height: 40px;
  }

  .nav {
    gap: 15px;
  }

  .nav-link {
    font-size: 0.85rem;
  }

  .cta-btn-primary {
    padding: 8px 16px;
    font-size: 0.85rem;
  }
}
